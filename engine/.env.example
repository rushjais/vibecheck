# LaunchGuard scan engine — environment variables
# Copy to .env for local runs:  cp .env.example .env

# Supabase — Project Settings → API. The SERVICE key (not the anon key) is
# required because the engine writes scan status + raw_findings server-side.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional: Railway sets PORT automatically. Defaults to 8000 locally.
# PORT=8000
