# ---------------------------------------------------------------------------
# LaunchGuard environment variables
# Copy this file to .env.local and fill in real values:  cp .env.local.example .env.local
# ---------------------------------------------------------------------------

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key (bypasses RLS). Used by route handlers / scan engine.
# Optional locally; required for privileged server writes.
SUPABASE_SERVICE_ROLE_KEY=

# Scan engine — URL of the service that clones + analyzes a repo
SCAN_ENGINE_URL=

# Anthropic — powers the plain-English report generation
ANTHROPIC_API_KEY=

# Stripe — billing for paid plans (server-side secret, use sk_test_... in dev)
STRIPE_SECRET_KEY=

# Admin funnel dashboard passphrase — /admin/funnel?key=<this>
ADMIN_PASSPHRASE=

# GitHub OAuth App (Pro auto-fix PRs). Create at github.com/settings/developers
# Authorization callback URL: <your-app-origin>/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# PostHog — product analytics (public, client-side key)
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog host (optional — defaults to https://us.i.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=

# Upstash Redis — per-IP rate limiting on scan creation.
# If either is blank, rate limiting is disabled (no-op).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
